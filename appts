6. app.component.css

src/app/app.component.css

.container {
  width: 90%;
  margin: 20px auto;
  font-family: Arial;
}

header {
  text-align: center;
  border: 1px solid #ccc;
  padding: 15px;
}

nav {
  margin-top: 15px;
}

nav a {
  margin: 15px;
  text-decoration: none;
  color: blue;
  cursor: pointer;
}


/* Advertisement */

.advertisement {
  width: 100%;
  height: 120px;
  overflow: hidden;
  margin-top: 10px;
  border: 1px solid #ccc;
}

.advertisement img {
  height: 120px;
  position: relative;

  animation: moveImage 5s linear infinite;
}


/* Image moves LEFT to RIGHT */

@keyframes moveImage {

  from {
    left: -300px;
  }

  to {
    left: 100%;
  }

}
