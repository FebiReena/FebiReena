import { Component } from '@angular/core';

import {
  trigger,
  transition,
  style,
  animate
} from '@angular/animations';

@Component({
  selector: 'app-student',
  templateUrl: './student.component.html',
  styleUrls: ['./student.component.css'],

  animations: [

    trigger('fade', [

      transition(':enter', [

        style({
          opacity: 0
        }),

        animate(
          '500ms',
          style({
            opacity: 1
          })
        )

      ])

    ])

  ]
})
export class StudentComponent {

  id = '';

  name = '';

  department = '';

  gender = '';

  hobbies: string[] = [];

  students: any[] = [];

  editIndex = -1;


  // CREATE / UPDATE

  addStudent() {

    const student = {

      id: this.id,

      name: this.name,

      department: this.department,

      gender: this.gender,

      hobbies: this.hobbies.join(', ')

    };


    if (this.editIndex == -1) {

      // CREATE

      this.students.push(student);

    }

    else {

      // UPDATE

      this.students[this.editIndex] = student;

      this.editIndex = -1;

    }


    this.clearForm();

  }


  // UPDATE

  editStudent(index: number) {

    this.editIndex = index;

    this.id = this.students[index].id;

    this.name = this.students[index].name;

    this.department =
      this.students[index].department;

    this.gender =
      this.students[index].gender;

    this.hobbies =
      this.students[index].hobbies.split(', ');

  }


  // DELETE

  deleteStudent(index: number) {

    this.students.splice(index, 1);

  }


  // CHECKBOX

  selectHobby(hobby: string) {

    if (this.hobbies.includes(hobby)) {

      this.hobbies =
        this.hobbies.filter(h => h !== hobby);

    }

    else {

      this.hobbies.push(hobby);

    }

  }


  // CLEAR FORM

  clearForm() {

    this.id = '';

    this.name = '';

    this.department = '';

    this.gender = '';

    this.hobbies = [];

    this.editIndex = -1;

  }

}
9. student.component.html

src/app/student/student.component.html

<div class="main">


  <!-- LEFT SIDE : FORM -->

  <div class="input-box">

    <h2>Student Form</h2>


    <label>ID</label>

    <input
      type="text"
      [(ngModel)]="id">


    <label>Name</label>

    <input
      type="text"
      [(ngModel)]="name">


    <label>Department</label>

    <select [(ngModel)]="department">

      <option value="">
        Select Department
      </option>

      <option value="Computer Science">
        Computer Science
      </option>

      <option value="Commerce">
        Commerce
      </option>

      <option value="Mathematics">
        Mathematics
      </option>

      <option value="Physics">
        Physics
      </option>

    </select>


    <label>Gender</label>

    <div>

      <input
        type="radio"
        name="gender"
        value="Male"
        [(ngModel)]="gender">

      Male


      <input
        type="radio"
        name="gender"
        value="Female"
        [(ngModel)]="gender">

      Female

    </div>


    <label>Hobbies</label>

    <div>

      <input
        type="checkbox"
        [checked]="hobbies.includes('Reading')"
        (change)="selectHobby('Reading')">

      Reading

      <br>

      <input
        type="checkbox"
        [checked]="hobbies.includes('Sports')"
        (change)="selectHobby('Sports')">

      Sports

    </div>


    <br>


    <button (click)="addStudent()">

      {{ editIndex == -1
          ? 'Add Student'
          : 'Update Student' }}

    </button>


    <button (click)="clearForm()">

      Clear

    </button>

  </div>



  <!-- RIGHT SIDE : TABLE -->

  <div class="output-box">

    <h2>Student Details</h2>


    <table>

      <tr>

        <th>ID</th>

        <th>Name</th>

        <th>Department</th>

        <th>Gender</th>

        <th>Hobbies</th>

        <th>Action</th>

      </tr>


      <!-- READ -->

      <tr
        *ngFor="
          let student of students;
          let i = index
        "
        @fade>


        <td>
          {{ student.id }}
        </td>


        <td>
          {{ student.name }}
        </td>


        <td>
          {{ student.department }}
        </td>


        <td>
          {{ student.gender }}
        </td>


        <td>
          {{ student.hobbies }}
        </td>


        <td>

          <button
            (click)="editStudent(i)">

            Edit

          </button>


          <button
            (click)="deleteStudent(i)">

            Delete

          </button>

        </td>

      </tr>

    </table>

  </div>

</div>
